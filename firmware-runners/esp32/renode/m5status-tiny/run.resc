using sysbus

:description: Minimal M5Status firmware smoke target for the GAR Renode path.
#
# This uses Renode's verified Xtensa sample-controller platform and upstream
# Zephyr hello-world ELF as the first executable firmware proof. It is not an
# ESP32/M5Stack board boot yet; see ../ROADMAP.md for the migration path.

$m5status_tiny_elf?=@https://dl.antmicro.com/projects/renode/xtensa-sample-controller-zephyr-hello-world.elf-s_293544-4be60f8a3891e70c30e1e8a471df4ad12ab08144

mach create "m5status-tiny"
machine LoadPlatformDescription @platforms/cpus/xtensa-sample-controller.repl

showAnalyzer sysbus.cpu.uartSemihosting

macro reset
"""
    sysbus LoadELF $m5status_tiny_elf
    cpu PC 0x50000000
"""
runMacro $reset

