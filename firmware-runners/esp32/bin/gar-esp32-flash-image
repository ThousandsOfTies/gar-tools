#!/usr/bin/env python3
from __future__ import annotations

import argparse
from pathlib import Path


DEFAULT_LAYOUT = (
    (0x1000, "bootloader.bin"),
    (0x8000, "partitions.bin"),
    (0xE000, "boot_app0.bin"),
    (0x10000, "firmware.bin"),
)


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Merge ESP32 bootloader, partitions, boot_app0, and app into a QEMU flash image."
    )
    parser.add_argument(
        "--artifact",
        type=Path,
        required=True,
        help="Directory containing bootloader.bin, partitions.bin, boot_app0.bin, firmware.bin.",
    )
    parser.add_argument(
        "--output",
        type=Path,
        required=True,
        help="Flash image path to write.",
    )
    parser.add_argument(
        "--flash-size",
        type=parse_size,
        default=parse_size("16MB"),
        help="Output flash size. Supports plain bytes, KB, MB. Default: 16MB.",
    )
    return parser.parse_args()


def parse_size(value: str) -> int:
    text = value.strip().lower()
    multiplier = 1
    if text.endswith("mb"):
        multiplier = 1024 * 1024
        text = text[:-2]
    elif text.endswith("m"):
        multiplier = 1024 * 1024
        text = text[:-1]
    elif text.endswith("kb"):
        multiplier = 1024
        text = text[:-2]
    elif text.endswith("k"):
        multiplier = 1024
        text = text[:-1]
    return int(text, 0) * multiplier


def main() -> int:
    args = parse_args()
    artifact = args.artifact.expanduser().resolve()
    output = args.output.expanduser().resolve()

    if not artifact.is_dir():
        raise SystemExit(f"artifact directory not found: {artifact}")

    image = bytearray([0xFF]) * args.flash_size

    for offset, filename in DEFAULT_LAYOUT:
        path = artifact / filename
        if not path.is_file():
            raise SystemExit(f"required file not found: {path}")
        data = path.read_bytes()
        end = offset + len(data)
        if end > len(image):
            raise SystemExit(
                f"{filename} at 0x{offset:x} exceeds flash size {args.flash_size} bytes"
            )
        image[offset:end] = data
        print(f"placed {filename:14} at 0x{offset:05x}..0x{end:05x} ({len(data)} bytes)")

    output.parent.mkdir(parents=True, exist_ok=True)
    output.write_bytes(image)
    print(f"wrote {output} ({len(image)} bytes)")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

