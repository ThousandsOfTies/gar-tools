[platformio]
default_envs = m5stackc
src_dir = {app_src}
{app_config}

[env:m5stackc]
; Keep the platform and libraries exact so generated workspaces are reproducible.
platform = platformio/espressif32@7.0.1
board = m5stick-c
framework = arduino
monitor_speed = 115200
extra_scripts = pre:scripts/env_flags.py
lib_deps =
  adafruit/Adafruit ILI9341@1.6.3
  adafruit/Adafruit GFX Library@1.12.6
  adafruit/Adafruit BusIO@1.17.4
