[platformio]
default_envs = m5stackc
src_dir = {app_src}
{app_config}

[env:m5stackc]
platform = espressif32
board = m5stick-c
framework = arduino
monitor_speed = 115200
extra_scripts = pre:scripts/env_flags.py
lib_deps =
  adafruit/Adafruit ILI9341
  adafruit/Adafruit GFX Library
  adafruit/Adafruit BusIO
