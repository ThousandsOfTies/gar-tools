{
  "id": "linux-device",
  "displayName": "Linux device / RasPi-compatible",
  "description": "Linux /dev compatible target using gpio-sim, CUSE I2C/SPI, and web-bridge runtime.",
  "toolsRoot": "targets/linux-device",
  "defaultBackends": {
    "codespace": "local",
    "simulator": "ssh_remote",
    "target": "adb_usb"
  },
  "backendNotes": {
    "simulator": "SSH Remote uses an Ubuntu Sim Host on VirtualBox or AWS. GPIO requires the host kernel gpio-sim module. Docker host settings remain available for existing local_docker workspaces.",
    "runtime": "targets/linux-device/runtime"
  },
  "simulation": {
    "docker": {
      "image": "gar-linux-device:latest",
      "buildContext": "targets/linux-device",
      "publishedBridgePort": 8080,
      "containerBridgePort": 8080,
      "publishedHost": "127.0.0.1",
      "init": ["/sbin/init"],
      "privileged": true,
      "hostCgroups": true,
      "environment": ["GAR_BRIDGE_HOST=0.0.0.0"],
      "tmpfs": ["/run", "/run/lock"],
      "mounts": [
        "/sys/fs/cgroup:/sys/fs/cgroup:rw",
        "/sys/kernel/config:/sys/kernel/config"
      ],
      "devices": ["/dev/fuse", "/dev/cuse"]
    }
  }
}
