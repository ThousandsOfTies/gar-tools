# Copy this file into the Product repository and commit intentionally selected
# board/layout values there. It describes UUU inputs, not the NXP BSP build.

# UUU 1.5.x understands MX91 as an SDPS device.  The old product script used
# an older uuu_version and an FBK: download command which current UUU rejects.
export GAR_UUU_VERSION=1.5.243

# Per-USB-bulk-operation timeout in milliseconds.  WSL2/usbipd can need more
# than UUU's 2-second default for a 1 MiB transfer chunk.
export GAR_UUU_TRANSFER_TIMEOUT_MS=30000

# U-Boot's FRDM-IMX91S fastboot staging buffer and the chunk size used by the
# UUU FB: write workaround. The generator makes zero-padded, transfer-only
# copies aligned to this chunk size; booti still receives the original sizes.
# The buffer is separate from loadaddr/fdt/initrd.
export GAR_IMX91S_FASTBOOT_BUFFER=0x82800000
export GAR_UUU_TRANSFER_CHUNK_SIZE=0x100000

# The U-Boot default initrd_addr=0x83800000 overlaps the FRDM-IMX91S ELE
# reserved range once this 17 MiB manufacturing ramdisk is loaded. Keep it in
# the free region above ELE and below OP-TEE.
export GAR_IMX91S_INITRD_ADDR=0x85000000

# NXP FRDM-IMX91S LPDDR4 machine values from the public BSP.
export GAR_IMX91S_DTB=imx91-11x11-frdm-imx91s.dtb

# The factory flow boots and installs the SPI-NAND U-Boot configuration. Its
# fspinand command writes the FCB/DBBT and redundant boot firmware correctly.
export GAR_IMX91S_RAM_BOOT_IMAGE=flash.bin
export GAR_IMX91S_NAND_BOOT_IMAGE=flash_spinand.bin
export GAR_IMX91S_NAND_DEVICE=spi-nand0

# Fixed partitions from imx91-11x11-frdm-imx91s.dts:
#   mtd0 bootloader 8 MiB, mtd1 config 8 MiB, mtd2 kernel 36 MiB,
#   mtd3 dtb 128 KiB, mtd4 rootfs (remaining NAND).
export GAR_IMX91S_NAND_BOOTLOADER_MTD=0
export GAR_IMX91S_NAND_CONFIG_MTD=1
export GAR_IMX91S_NAND_KERNEL_MTD=2
export GAR_IMX91S_NAND_DTB_MTD=3
export GAR_IMX91S_NAND_ROOTFS_MTD=4

# Safety gate.  Leave 0 while iterating or doing -dry validation.  Set to 1
# only after /proc/mtd and the partition names/sizes have been verified on the
# actual FRDM-IMX91S board with Inspect-imx91s-layout.lst.
export GAR_IMX91S_NAND_LAYOUT_CONFIRMED=0

# Optional paths used by the helper scripts.
# export GAR_UUU_BIN=/home/user/.local/bin/uuu
# export GAR_IMX91S_FACTORY_SCRIPT_NAME=Factory-uuu-my-product.lst
# export GAR_IMX91S_OUTPUT=artifacts/from-codespace/Factory-uuu-my-product.lst
