#!/bin/sh
# Root-owned, sudo-restricted installer contract used by GAR target deploy.
set -eu

fail() {
    echo "gar-target-install: $*" >&2
    exit 2
}

valid_destination() {
    case "$1" in
        /opt/gar/apps/*) name=${1#/opt/gar/apps/} ;;
        /etc/gar/system/*.env) name=${1#/etc/gar/system/} ;;
        /etc/gar/*.env) name=${1#/etc/gar/} ;;
        *) return 1 ;;
    esac
    case "$name" in ""|*/*|.*) return 1 ;; esac
}

validate_app() {
    case "$1" in ""|.*|*[!A-Za-z0-9._-]*) fail "invalid application name" ;; esac
}

harden_application_payload() {
    application_root=$1
    chmod go-w "$application_root"
    for marker in \
        "$application_root/.artifact-info.json" \
        "$application_root/.gar-artifact.json"
    do
        if [ -e "$marker" ] || [ -L "$marker" ]; then
            [ -f "$marker" ] && [ ! -L "$marker" ] || fail "artifact provenance marker must be a regular file"
            chown root:root "$marker"
            chmod 0444 "$marker"
        fi
    done
}

register_app() {
    app=$1
    validate_app "$app"
    [ -x "/opt/gar/apps/$app/run" ] || fail "application entry point is missing: /opt/gar/apps/$app/run"
    unit="gar-app@$app.service"
    systemctl daemon-reload
    systemctl enable "$unit"
}

case "${1:-}" in
    install)
        [ "$#" -eq 4 ] || fail "usage: install STAGED_SOURCE DESTINATION MODE"
        source=$2
        destination=$3
        mode=$4
        valid_destination "$destination" || fail "destination is not permitted: $destination"
        case "$source" in /tmp/gar-stage-*/payload) ;; *) fail "staging path is not permitted" ;; esac
        resolved=$(realpath -e -- "$source") || fail "staged source is missing"
        case "$resolved" in /tmp/gar-stage-*/payload) ;; *) fail "staged source escapes its directory" ;; esac
        case "$mode" in [0-7][0-7][0-7]|[0-7][0-7][0-7][0-7]) ;; *) fail "invalid mode" ;; esac
        case "$destination" in
            /etc/gar/system/*.env) [ "$mode" = "0644" ] || fail "runtime environment files require mode 0644" ;;
        esac
        parent=$(dirname -- "$destination")
        temporary="${destination}.gar-new.$$"
        backup="${destination}.gar-old.$$"
        mkdir -p "$parent"
        rm -rf -- "$temporary" "$backup"
        cp -a -- "$resolved" "$temporary" || {
            rm -rf -- "$temporary"
            fail "cannot stage application payload"
        }
        chown -R root:root "$temporary" || {
            rm -rf -- "$temporary"
            fail "cannot set payload ownership"
        }
        chmod "$mode" "$temporary" || {
            rm -rf -- "$temporary"
            fail "cannot set payload mode"
        }
        case "$destination" in
            /opt/gar/apps/*) harden_application_payload "$temporary" ;;
        esac
        had_destination=0
        if [ -e "$destination" ] || [ -L "$destination" ]; then
            mv -- "$destination" "$backup" || {
                rm -rf -- "$temporary"
                fail "cannot preserve previous destination"
            }
            had_destination=1
        fi
        if mv -- "$temporary" "$destination"; then
            rm -rf -- "$backup" || true
        else
            if [ "$had_destination" -eq 1 ]; then
                mv -- "$backup" "$destination" || fail "cannot restore previous destination"
            fi
            rm -rf -- "$temporary"
            fail "cannot activate staged payload"
        fi
        ;;
    register-app)
        [ "$#" -eq 2 ] || fail "usage: register-app APP_NAME"
        register_app "$2"
        ;;
    enable-app)
        [ "$#" -eq 2 ] || fail "usage: enable-app APP_NAME"
        register_app "$2"
        app=$2
        unit="gar-app@$app.service"
        systemctl restart "$unit"
        ;;
    *) fail "unknown action" ;;
esac
