{
  "schema_version": 1,
  "target_id": "raspberry-pi-5",
  "platform": {
    "architecture": "aarch64",
    "abi": "gnu",
    "toolchain_triple": "aarch64-linux-gnu",
    "init_system": "systemd",
    "privilege_model": "sudo-noninteractive"
  },
  "resources": [
    {
      "id": "gpio0",
      "kind": "gpio",
      "device": "/dev/gpiochip0",
      "voltage_v": 3.3,
      "drivers": [
        "pinctrl-rp1",
        "gpio-cdev"
      ],
      "pinmux": {
        "id": "gpio",
        "settings": []
      },
      "lines": [
        17,
        22,
        23,
        24,
        27
      ],
      "line_pins": {
        "17": "11",
        "22": "15",
        "23": "16",
        "24": "18",
        "27": "13"
      },
      "directions": [
        "input",
        "output"
      ]
    },
    {
      "id": "spi0.cs0",
      "kind": "spi",
      "device": "/dev/spidev0.0",
      "voltage_v": 3.3,
      "drivers": [
        "spi-bcm2835",
        "spidev"
      ],
      "pinmux": {
        "id": "spi0",
        "settings": ["dtparam=spi=on"]
      },
      "bus": 0,
      "chip_select": 0,
      "max_speed_hz": 50000000,
      "modes": [0, 1, 2, 3],
      "signal_pins": {
        "MOSI": "19",
        "MISO": "21",
        "SCLK": "23",
        "CS0": "24"
      }
    },
    {
      "id": "usb-uvc",
      "kind": "video",
      "device": "/dev/video0",
      "voltage_v": 5.0,
      "drivers": [
        "uvcvideo",
        "videodev"
      ],
      "pinmux": {
        "id": "usb",
        "settings": []
      },
      "max_fps": 30,
      "signal_pins": {
        "USB": "USB 3.0"
      }
    },
    {
      "id": "network0",
      "kind": "network",
      "device": "eth0",
      "drivers": [
        "linux-netdev",
        "macb"
      ],
      "pinmux": {
        "id": "ethernet",
        "settings": []
      },
      "signal_pins": {
        "Ethernet": "RJ45"
      }
    }
  ]
}
