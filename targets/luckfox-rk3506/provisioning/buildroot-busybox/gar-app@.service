#!/bin/sh
# BusyBox init template. @GAR_APP@ is replaced by gar-target-install.

app=@GAR_APP@
app_dir="/opt/gar/apps/$app"
run="$app_dir/run"
pid_file="/var/run/gar-$app.pid"
log_dir=/var/log/gar
log_file="$log_dir/$app.log"
reboot_required_file="/var/lib/gar-target/state/$app.reboot-required"
persistent_environment_file="/etc/gar/$app.env"
runtime_environment_file="/etc/gar/system/$app.env"

load_environment_file() {
    environment_file=$1
    [ -e "$environment_file" ] || return 0
    [ -f "$environment_file" ] && [ ! -L "$environment_file" ] || {
        echo "GAR environment file is not a regular file: $environment_file" >&2
        return 1
    }
    while IFS= read -r environment_line || [ -n "$environment_line" ]; do
        case "$environment_line" in
            ""|\#*) continue ;;
        esac
        environment_key=${environment_line%%=*}
        environment_value=${environment_line#*=}
        [ "$environment_key" != "$environment_line" ] || {
            echo "GAR environment line is not KEY=VALUE: $environment_file" >&2
            return 1
        }
        case "$environment_key" in
            ""|[!A-Za-z_]*|*[!A-Za-z0-9_]*)
                echo "GAR environment key is invalid: $environment_file" >&2
                return 1
                ;;
        esac
        export "$environment_key=$environment_value"
    done <"$environment_file"
}

process_start_time() {
    process_pid=$1
    [ -r "/proc/$process_pid/stat" ] || return 1
    process_stat=$(cat "/proc/$process_pid/stat" 2>/dev/null) || return 1
    process_fields=${process_stat##*) }
    [ "$process_fields" != "$process_stat" ] || return 1
    set -- $process_fields
    [ "$#" -ge 20 ] || return 1
    shift 19
    case "$1" in ""|*[!0-9]*) return 1 ;; esac
    printf '%s\n' "$1"
}

read_pid_identity() {
    [ -f "$pid_file" ] || return 1
    IFS=' ' read -r pid recorded_start_time extra <"$pid_file" || return 1
    case "$pid" in ""|*[!0-9]*) return 1 ;; esac
    case "$recorded_start_time" in ""|*[!0-9]*) return 1 ;; esac
    [ -z "$extra" ] && [ "$pid" -gt 1 ] 2>/dev/null
}

pid_identity_matches() {
    kill -0 "$pid" 2>/dev/null || return 1
    current_start_time=$(process_start_time "$pid") || return 1
    [ "$current_start_time" = "$recorded_start_time" ]
}

is_running() {
    if read_pid_identity && pid_identity_matches; then
        return 0
    fi
    rm -f "$pid_file"
    return 1
}

start() {
    [ -x "$run" ] || {
        echo "GAR application entry point is missing: $run" >&2
        return 1
    }
    if is_running; then
        echo "$app is already running"
        return 0
    fi
    mkdir -p "$log_dir" /var/run
    rm -f "$pid_file"
    (
        cd "$app_dir"
        load_environment_file "$persistent_environment_file"
        load_environment_file "$runtime_environment_file"
        "$run" >>"$log_file" 2>&1 &
        pid=$!
        recorded_start_time=$(process_start_time "$pid") || {
            kill "$pid" 2>/dev/null || true
            echo "$app failed to expose a stable process identity" >&2
            return 1
        }
        pid_file_temporary="${pid_file}.gar-new.$$"
        (umask 077; printf '%s %s\n' "$pid" "$recorded_start_time" >"$pid_file_temporary")
        mv "$pid_file_temporary" "$pid_file"
    )
    sleep 1
    if ! is_running; then
        echo "$app failed to start; recent log follows:" >&2
        tail -n 20 "$log_file" >&2 2>/dev/null || true
        rm -f "$pid_file"
        return 1
    fi
    rm -f "$reboot_required_file"
    echo "Started $app"
}

stop() {
    if ! is_running; then
        rm -f "$pid_file"
        return 0
    fi
    kill "$pid" 2>/dev/null || true
    count=0
    while pid_identity_matches && [ "$count" -lt 20 ]; do
        sleep 0.1
        count=$((count + 1))
    done
    if pid_identity_matches; then
        kill -9 "$pid" 2>/dev/null || true
    fi
    rm -f "$pid_file"
    echo "Stopped $app"
}

case "${1:-}" in
    start) start ;;
    stop) stop ;;
    restart) stop; start ;;
    status)
        if is_running; then
            echo "$app is running"
        else
            echo "$app is stopped"
            exit 1
        fi
        ;;
    *) echo "Usage: $0 {start|stop|restart|status}" >&2; exit 2 ;;
esac
