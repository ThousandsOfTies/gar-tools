# Copy to env.local and adjust for your Luckfox SDK installation.
export RV1106_TOOLCHAIN_BIN=/opt/luckfox-sdk/toolchain/bin
export RV1106_SYSROOT=/opt/luckfox-sdk/toolchain/arm-buildroot-linux-gnueabihf/sysroot
export RV1106_TRIPLE=arm-buildroot-linux-gnueabihf

# SSH target used by deploy script
export LUCKFOX_HOST=root@10.42.0.1
export LUCKFOX_DEPLOY_DIR=/opt/gar/bin
