#!/usr/bin/env bash
set -euo pipefail

# Terminal-based rotary encoder simulator for Luckfox flow.
# Emits JSONL events for later integration.

event_log="${GAR_ROTARY_EVENT_LOG:-/tmp/gar-rotary-events.jsonl}"
use_unicode="${GAR_ROTARY_UI_UNICODE:-1}"

mkdir -p "$(dirname "$event_log")"
touch "$event_log"

names=(
  "BRIGHTNESS"
  "CONTRAST"
  "SATURATION"
  "SHARPNESS"
  "EXPOSURE_COMP"
  "FPS"
  "BITRATE"
)

mins=(0 0 0 0 -4 5 500)
maxs=(100 100 100 100 4 60 8000)
steps=(1 1 1 1 1 1 100)
values=(50 50 50 50 0 15 1500)

focus=0
mode="NAV"

symbol_left="<"
symbol_center="o"
symbol_right=">"
if [[ "$use_unicode" == "1" ]]; then
  symbol_left="◀"
  symbol_center="●"
  symbol_right="▶"
fi

append_event() {
  local type="$1"
  local item="$2"
  local value="$3"
  local ts
  ts="$(date +%s)"
  printf '{"ts":%s,"type":"%s","item":"%s","value":%s,"mode":"%s"}\n' \
    "$ts" "$type" "$item" "$value" "$mode" >>"$event_log"
}

render() {
  clear
  echo "GAR Luckfox Rotary Simulator"
  echo ""
  echo "  ${symbol_left} ${symbol_center} ${symbol_right}"
  echo ""
  echo "Mode: $mode"
  echo "Event log: $event_log"
  echo ""
  echo "Controls:"
  echo "  Left/Right arrow or a/d : rotate"
  echo "  Enter or s              : press"
  echo "  q                       : quit"
  echo ""
  echo "Parameters:"
  local i
  for i in "${!names[@]}"; do
    local mark=" "
    if [[ "$i" -eq "$focus" ]]; then
      mark=">"
    fi
    printf " %s %-14s %6s (min=%s max=%s step=%s)\n" \
      "$mark" "${names[$i]}" "${values[$i]}" "${mins[$i]}" "${maxs[$i]}" "${steps[$i]}"
  done
}

clamp_value() {
  local idx="$1"
  local v="$2"
  if (( v < mins[idx] )); then
    v="${mins[$idx]}"
  fi
  if (( v > maxs[idx] )); then
    v="${maxs[$idx]}"
  fi
  values[$idx]="$v"
}

rotate_left() {
  if [[ "$mode" == "NAV" ]]; then
    focus=$(( (focus - 1 + ${#names[@]}) % ${#names[@]} ))
    append_event "focus" "${names[$focus]}" "${values[$focus]}"
  else
    local next=$(( values[focus] - steps[focus] ))
    clamp_value "$focus" "$next"
    append_event "change" "${names[$focus]}" "${values[$focus]}"
  fi
}

rotate_right() {
  if [[ "$mode" == "NAV" ]]; then
    focus=$(( (focus + 1) % ${#names[@]} ))
    append_event "focus" "${names[$focus]}" "${values[$focus]}"
  else
    local next=$(( values[focus] + steps[focus] ))
    clamp_value "$focus" "$next"
    append_event "change" "${names[$focus]}" "${values[$focus]}"
  fi
}

press_center() {
  if [[ "$mode" == "NAV" ]]; then
    mode="EDIT"
    append_event "press" "${names[$focus]}" "${values[$focus]}"
  else
    mode="NAV"
    append_event "commit" "${names[$focus]}" "${values[$focus]}"
  fi
}

read_key() {
  local key
  IFS= read -rsn1 key || return 1
  if [[ "$key" == $'\e' ]]; then
    local k1 k2
    IFS= read -rsn1 k1 || true
    IFS= read -rsn1 k2 || true
    if [[ "$k1$k2" == "[D" ]]; then
      echo "LEFT"
      return 0
    fi
    if [[ "$k1$k2" == "[C" ]]; then
      echo "RIGHT"
      return 0
    fi
    echo "ESC"
    return 0
  fi
  if [[ -z "$key" || "$key" == $'\n' ]]; then
    echo "ENTER"
    return 0
  fi
  case "$key" in
    a|h) echo "LEFT" ;;
    d|l) echo "RIGHT" ;;
    s) echo "ENTER" ;;
    q) echo "QUIT" ;;
    *) echo "OTHER" ;;
  esac
}

append_event "start" "${names[$focus]}" "${values[$focus]}"

while true; do
  render
  action="$(read_key || echo QUIT)"
  case "$action" in
    LEFT)
      rotate_left
      ;;
    RIGHT)
      rotate_right
      ;;
    ENTER)
      press_center
      ;;
    QUIT)
      append_event "stop" "${names[$focus]}" "${values[$focus]}"
      echo ""
      echo "bye"
      exit 0
      ;;
    *)
      ;;
  esac
done
