#!/usr/bin/env python3
import argparse
import json
import os
import time
from pathlib import Path


def load_state(path: Path) -> dict:
    if not path.exists():
        return {}
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except Exception:
        return {}


def bar(value: int, min_v: int, max_v: int, width: int = 20) -> str:
    if max_v <= min_v:
        return "-" * width
    ratio = (value - min_v) / float(max_v - min_v)
    ratio = max(0.0, min(1.0, ratio))
    fill = int(round(ratio * width))
    return "#" * fill + "." * (width - fill)


def render_frame(state: dict) -> str:
    mode = state.get("MODE", "NAV")
    focus = state.get("FOCUS", "BRIGHTNESS")

    b = int(state.get("BRIGHTNESS", 50))
    c = int(state.get("CONTRAST", 50))
    s = int(state.get("SATURATION", 50))
    sh = int(state.get("SHARPNESS", 50))
    e = int(state.get("EXPOSURE_COMP", 0))
    fps = int(state.get("FPS", 15))
    br = int(state.get("BITRATE", 1500))

    lines = []
    lines.append("+------------------------------------------+")
    lines.append("| Luckfox Monitor Simulator                |")
    lines.append(f"| Mode: {mode:<6} Focus: {focus:<16}|")
    lines.append("|                                          |")
    lines.append(f"| BRIGHTNESS  [{bar(b, 0, 100)}] {b:>3} |")
    lines.append(f"| CONTRAST    [{bar(c, 0, 100)}] {c:>3} |")
    lines.append(f"| SATURATION  [{bar(s, 0, 100)}] {s:>3} |")
    lines.append(f"| SHARPNESS   [{bar(sh, 0, 100)}] {sh:>3} |")
    lines.append(f"| EXP COMP    [{bar(e, -4, 4)}] {e:>3} |")
    lines.append(f"| FPS         [{bar(fps, 5, 60)}] {fps:>3} |")
    lines.append(f"| BITRATE(k)  [{bar(br, 500, 8000)}] {br:>4} |")
    lines.append("|                                          |")
    lines.append("| Rotary UI hint:  \u25c0  \u25cf  \u25b6                 |")
    lines.append("+------------------------------------------+")
    return "\n".join(lines) + "\n"


def main() -> int:
    parser = argparse.ArgumentParser(description="GAR Luckfox monitor output simulator")
    parser.add_argument(
        "--state-file",
        default=os.environ.get("GAR_ISP_STATE_FILE", "/tmp/gar-isp-state.json"),
        help="input state JSON file",
    )
    parser.add_argument(
        "--frame-file",
        default=os.environ.get("GAR_MONITOR_FRAME_FILE", "/tmp/gar-monitor-frame.txt"),
        help="output frame text file",
    )
    parser.add_argument(
        "--interval",
        type=float,
        default=float(os.environ.get("GAR_MONITOR_INTERVAL", "0.2")),
        help="refresh interval seconds",
    )
    parser.add_argument(
        "--terminal",
        action="store_true",
        help="also render to terminal",
    )
    parser.add_argument(
        "--once",
        action="store_true",
        help="render once and exit",
    )
    args = parser.parse_args()

    state_file = Path(args.state_file)
    frame_file = Path(args.frame_file)
    frame_file.parent.mkdir(parents=True, exist_ok=True)

    while True:
        state = load_state(state_file)
        frame = render_frame(state)
        frame_file.write_text(frame, encoding="utf-8")

        if args.terminal:
            print("\x1b[2J\x1b[H", end="")
            print(frame, end="")
            print(f"state={state_file} frame={frame_file}")

        if args.once:
            return 0

        time.sleep(args.interval)


if __name__ == "__main__":
    raise SystemExit(main())
