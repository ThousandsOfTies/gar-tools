#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
runtime_root="$(cd "$script_dir/.." && pwd)"
run_dir="${GAR_RUNTIME_DIR:-/tmp/gar-luckfox-runtime}"

stop_by_pidfile() {
  local name="$1"
  local pidfile="$run_dir/$name.pid"
  if [[ ! -f "$pidfile" ]]; then
    return
  fi
  local pid
  pid="$(cat "$pidfile")"
  if kill -0 "$pid" 2>/dev/null; then
    kill "$pid" || true
  fi
  rm -f "$pidfile"
}

echo "[devfs-stop] stopping runtime in $run_dir"

stop_by_pidfile "cuse_spi"
stop_by_pidfile "cuse_i2c"
stop_by_pidfile "bridge"

echo "[devfs-stop] done"
echo "[devfs-stop] remaining processes (if any):"
pgrep -af "cuse_i2c|cuse_spi|bridge.py" || true
