#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
runtime_root="$(cd "$script_dir/.." && pwd)"
run_dir="${GAR_RUNTIME_DIR:-/tmp/gar-luckfox-runtime}"
linux_runtime_root="${GAR_LINUX_RUNTIME_ROOT:-$runtime_root/../../linux-device/runtime}"

bridge_py="${GAR_BRIDGE_PY:-$linux_runtime_root/web-bridge/bridge.py}"
cuse_i2c_bin="${GAR_CUSE_I2C:-$linux_runtime_root/i2c-stub/cuse_i2c}"
cuse_spi_bin="${GAR_CUSE_SPI:-$linux_runtime_root/ili9341-stub/cuse_spi_ili9341}"

stop_by_pidfile() {
  local name="$1"
  local expected="$2"
  local pidfile="$run_dir/$name.pid"
  if [[ ! -f "$pidfile" ]]; then
    return
  fi
  local pid
  read -r pid <"$pidfile"
  if [[ ! "$pid" =~ ^[1-9][0-9]*$ ]]; then
    echo "[devfs-stop] ignoring invalid PID in $pidfile"
  elif kill -0 "$pid" 2>/dev/null; then
    local command_line
    command_line="$(tr '\0' ' ' <"/proc/$pid/cmdline" 2>/dev/null || true)"
    if [[ "$command_line" != *"$expected"* ]]; then
      echo "[devfs-stop] refusing to signal reused PID $pid for $name"
      rm -f "$pidfile"
      return
    fi
    kill "$pid" || true
  fi
  rm -f "$pidfile"
}

echo "[devfs-stop] stopping runtime in $run_dir"

stop_by_pidfile "cuse_spi" "$cuse_spi_bin"
stop_by_pidfile "cuse_i2c" "$cuse_i2c_bin"
stop_by_pidfile "bridge" "$bridge_py"

echo "[devfs-stop] done"
echo "[devfs-stop] remaining processes (if any):"
pgrep -af "cuse_i2c|cuse_spi|bridge.py" || true
