#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

event_log="${GAR_ROTARY_EVENT_LOG:-/tmp/gar-rotary-events.jsonl}"
state_file="${GAR_ISP_STATE_FILE:-/tmp/gar-isp-state.json}"
apply_log="${GAR_ISP_APPLY_LOG:-/tmp/gar-isp-apply.jsonl}"

engine="$script_dir/gar-luckfox-sim-isp-engine"
ui="$script_dir/gar-luckfox-sim-rotary-ui"

if [[ ! -x "$engine" ]]; then
  echo "missing engine: $engine"
  exit 1
fi
if [[ ! -x "$ui" ]]; then
  echo "missing ui: $ui"
  exit 1
fi

echo "[sim-loop] event_log=$event_log"
echo "[sim-loop] state_file=$state_file"
echo "[sim-loop] apply_log=$apply_log"

touch "$event_log"

GAR_ROTARY_EVENT_LOG="$event_log" GAR_ISP_STATE_FILE="$state_file" GAR_ISP_APPLY_LOG="$apply_log" \
  "$engine" --follow --echo &
engine_pid=$!

cleanup() {
  if kill -0 "$engine_pid" 2>/dev/null; then
    kill "$engine_pid" || true
    wait "$engine_pid" 2>/dev/null || true
  fi
}
trap cleanup EXIT INT TERM

GAR_ROTARY_EVENT_LOG="$event_log" "$ui"
